{
  "openapi": "3.0.3",
  "info": {
    "title": "JKT48 Data API",
    "description": "Read-only REST API untuk data JKT48: member, single, generasi, tim, kapten, statistik agregat, serta katalog diskografi (lagu, album, coupling, setlist, sub-unit, lokasi syuting MV). Semua endpoint mengembalikan JSON.\n\n_JKT48 Data API disusun oleh **Rebornian48**._",
    "version": "1.1.0",
    "contact": {
      "name": "Rebornian48",
      "email": "jkt48newfans@gmail.com"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    { "url": "/api", "description": "Current host" }
  ],
  "tags": [
    { "name": "Members", "description": "Data member JKT48" },
    { "name": "Singles", "description": "Daftar single & senbatsu" },
    { "name": "Generations", "description": "Generasi member" },
    { "name": "Teams", "description": "Tim (Team J, KIII, T, dsb.)" },
    { "name": "Captains", "description": "Riwayat kapten tim / JKT48" },
    { "name": "Statistics", "description": "Statistik agregat" },
    { "name": "Songs", "description": "Katalog 425+ lagu (Diskografi)" },
    { "name": "Albums", "description": "Album studio & mini album/EP + tracklist" },
    { "name": "Setlists", "description": "Setlist teater reguler & special" },
    { "name": "Coupling Songs", "description": "Coupling B-side setiap single beserta member" },
    { "name": "Sub-Units", "description": "Sub-unit dan lagu-lagunya" },
    { "name": "MV Locations", "description": "Lokasi syuting music video" }
  ],
  "paths": {
    "/v1/members": {
      "get": {
        "tags": ["Members"],
        "summary": "List members",
        "description": "Ambil daftar member dengan filter opsional.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "status",
            "in": "query",
            "description": "Filter berdasarkan status member.",
            "schema": { "type": "string", "enum": ["Aktif", "Lulus", "Trainee"] }
          },
          {
            "name": "generation_id",
            "in": "query",
            "description": "Filter berdasarkan ID generasi.",
            "schema": { "type": "integer", "example": 1 }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Pencarian pada name / nickname / birth_place.",
            "schema": { "type": "string", "example": "shani" }
          },
          {
            "name": "sort",
            "in": "query",
            "description": "Kolom sort. Awali `-` untuk descending.",
            "schema": {
              "type": "string",
              "enum": ["name", "join_date", "birth_date", "graduation_date", "-name", "-join_date", "-birth_date", "-graduation_date"],
              "default": "name"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/Member" }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/v1/members/{id}": {
      "get": {
        "tags": ["Members"],
        "summary": "Get member detail",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/Member" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/singles": {
      "get": {
        "tags": ["Singles"],
        "summary": "List singles",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "search",
            "in": "query",
            "description": "Cari di title / code single.",
            "schema": { "type": "string" }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["sequence", "release_date", "title", "-sequence", "-release_date", "-title"],
              "default": "sequence"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Single" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/singles/{id}": {
      "get": {
        "tags": ["Singles"],
        "summary": "Get single detail (with senbatsu members)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/Single" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/generations": {
      "get": {
        "tags": ["Generations"],
        "summary": "List generations",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["join_date", "announcement_date", "name", "-join_date", "-announcement_date", "-name"],
              "default": "join_date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Generation" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/generations/{id}": {
      "get": {
        "tags": ["Generations"],
        "summary": "Get generation detail (with members)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/Generation" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/teams": {
      "get": {
        "tags": ["Teams"],
        "summary": "List teams",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "active_only",
            "in": "query",
            "description": "Hanya tim yang belum disbanded.",
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Team" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/teams/{id}": {
      "get": {
        "tags": ["Teams"],
        "summary": "Get team detail (with current members & captains)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "data": { "$ref": "#/components/schemas/Team" } }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/captains": {
      "get": {
        "tags": ["Captains"],
        "summary": "List captains (with member & team)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "active_only",
            "in": "query",
            "description": "Hanya kapten yang masih menjabat.",
            "schema": { "type": "boolean" }
          },
          {
            "name": "team_id",
            "in": "query",
            "description": "Filter berdasarkan ID tim.",
            "schema": { "type": "integer" }
          },
          {
            "name": "role",
            "in": "query",
            "description": "Filter berdasarkan role (mis. \"Kapten\", \"Wakil Kapten\").",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/PaginatedEnvelope" },
                    {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Captain" } }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/songs": {
      "get": {
        "tags": ["Songs"],
        "summary": "List songs",
        "description": "Katalog master 425+ lagu JKT48 (dari sheet 'Semua Lagu' Diskografi.xlsx).",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "search",       "in": "query", "description": "Cari di title / title_original.", "schema": { "type": "string" } },
          { "name": "single_id",    "in": "query", "description": "Filter berdasarkan single.", "schema": { "type": "integer" } },
          { "name": "origin_group", "in": "query", "description": "Filter asal grup.", "schema": { "type": "string", "enum": ["AKB48","SKE48","NMB48","HKT48","NGT48","Original"] } },
          { "name": "released",     "in": "query", "description": "true = sudah rilis, false = belum.", "schema": { "type": "boolean" } },
          { "name": "sort",         "in": "query", "schema": { "type": "string", "enum": ["external_id","title","debut_date","-external_id","-title","-debut_date"], "default": "external_id" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Song" } } } }
            ] } } }
          },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/v1/songs/{id}": {
      "get": {
        "tags": ["Songs"],
        "summary": "Get song detail",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Song" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/albums": {
      "get": {
        "tags": ["Albums"],
        "summary": "List albums & EPs",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "type", "in": "query", "description": "Filter tipe rilis.", "schema": { "type": "string", "enum": ["album","ep"] } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Album" } } } }
            ] } } }
          }
        }
      }
    },
    "/v1/albums/{id}": {
      "get": {
        "tags": ["Albums"],
        "summary": "Get album detail (with tracklist)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Album" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/setlists": {
      "get": {
        "tags": ["Setlists"],
        "summary": "List setlists",
        "description": "17 setlist reguler + 10 setlist special dari sheet 'Semua Lagu'.",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "type",   "in": "query", "schema": { "type": "string", "enum": ["regular","special"] } },
          { "name": "search", "in": "query", "description": "Cari di nama setlist.", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Setlist" } } } }
            ] } } }
          }
        }
      }
    },
    "/v1/setlists/{id}": {
      "get": {
        "tags": ["Setlists"],
        "summary": "Get setlist detail (with ordered songs)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Setlist" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/coupling-songs": {
      "get": {
        "tags": ["Coupling Songs"],
        "summary": "List coupling songs (B-side)",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "single_id", "in": "query", "description": "Filter berdasarkan single induk.", "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/CouplingSong" } } } }
            ] } } }
          }
        }
      }
    },
    "/v1/coupling-songs/{id}": {
      "get": {
        "tags": ["Coupling Songs"],
        "summary": "Get coupling song detail (with members)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/CouplingSong" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/sub-units": {
      "get": {
        "tags": ["Sub-Units"],
        "summary": "List sub-units",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/SubUnit" } } } }
            ] } } }
          }
        }
      }
    },
    "/v1/sub-units/{id}": {
      "get": {
        "tags": ["Sub-Units"],
        "summary": "Get sub-unit detail (with songs)",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/SubUnit" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/mv-locations": {
      "get": {
        "tags": ["MV Locations"],
        "summary": "List MV shooting locations",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "category",   "in": "query", "description": "Kategori (Single / Album Studio / dsb.)", "schema": { "type": "string" } },
          { "name": "year",       "in": "query", "schema": { "type": "integer", "example": 2024 } },
          { "name": "has_coords", "in": "query", "description": "Hanya yang sudah di-geocode.", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": { "application/json": { "schema": { "allOf": [
              { "$ref": "#/components/schemas/PaginatedEnvelope" },
              { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/MvLocation" } } } }
            ] } } }
          }
        }
      }
    },
    "/v1/mv-locations/{id}": {
      "get": {
        "tags": ["MV Locations"],
        "summary": "Get MV location detail",
        "parameters": [{ "$ref": "#/components/parameters/IdPath" }],
        "responses": {
          "200": { "description": "OK", "content": { "application/json": { "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/MvLocation" } } } } } },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/statistics": {
      "get": {
        "tags": ["Statistics"],
        "summary": "Aggregate statistics",
        "description": "Ringkasan total member, single, generasi, dan breakdown per generasi.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "totals": {
                          "type": "object",
                          "properties": {
                            "members":     { "type": "integer" },
                            "active":      { "type": "integer" },
                            "graduated":   { "type": "integer" },
                            "trainee":     { "type": "integer" },
                            "singles":     { "type": "integer" },
                            "teams":       { "type": "integer" },
                            "generations": { "type": "integer" }
                          }
                        },
                        "per_generation": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id":              { "type": "integer" },
                              "code":            { "type": "string" },
                              "name":            { "type": "string" },
                              "join_date":       { "type": "string", "format": "date", "nullable": true },
                              "members_count":   { "type": "integer" },
                              "active_count":    { "type": "integer" },
                              "graduated_count": { "type": "integer" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "description": "Nomor halaman (mulai dari 1).",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "description": "Jumlah item per halaman.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 200, "default": 25 }
      },
      "IdPath": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ID resource.",
        "schema": { "type": "integer", "example": 1 }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource tidak ditemukan.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "message": "No query results for model." }
          }
        }
      },
      "ValidationError": {
        "description": "Parameter tidak valid.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ValidationError" }
          }
        }
      }
    },
    "schemas": {
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": { "type": "integer" },
          "from":         { "type": "integer", "nullable": true },
          "to":           { "type": "integer", "nullable": true },
          "per_page":     { "type": "integer" },
          "last_page":    { "type": "integer" },
          "total":        { "type": "integer" },
          "path":         { "type": "string" }
        }
      },
      "PaginationLinks": {
        "type": "object",
        "properties": {
          "first": { "type": "string", "nullable": true },
          "last":  { "type": "string", "nullable": true },
          "prev":  { "type": "string", "nullable": true },
          "next":  { "type": "string", "nullable": true }
        }
      },
      "PaginatedEnvelope": {
        "type": "object",
        "properties": {
          "data":  { "type": "array", "items": { "type": "object" } },
          "links": { "$ref": "#/components/schemas/PaginationLinks" },
          "meta":  { "$ref": "#/components/schemas/PaginationMeta" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      },
      "Member": {
        "type": "object",
        "properties": {
          "id":                        { "type": "integer" },
          "name":                      { "type": "string" },
          "nickname":                  { "type": "string", "nullable": true },
          "birth_place":               { "type": "string", "nullable": true },
          "birth_date":                { "type": "string", "format": "date", "nullable": true },
          "status":                    { "type": "string", "enum": ["Aktif", "Lulus", "Trainee"] },
          "restructure_status":        { "type": "string", "nullable": true },
          "photo_url":                 { "type": "string", "nullable": true },
          "bio":                       { "type": "string", "nullable": true },
          "join_date":                 { "type": "string", "format": "date", "nullable": true },
          "effective_join_date":       { "type": "string", "format": "date", "nullable": true },
          "cancelled_date":            { "type": "string", "format": "date", "nullable": true },
