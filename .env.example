APP_NAME="JKT48 Database"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=jkt48_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Google Sheets (JKT48MapSeeder)
GOOGLE_SHEETS_API_KEY=
JKT48_MAP_SHEET_ID=1FinIC52jFCi5fL7oN5qZ-BKocZvBfxbiCTrzXetnANo

# ---------- Bot notifications ----------
# Telegram: buat bot via @BotFather, ambil token.
# Isi chat id (bisa multiple, koma). Cara cek chat id: kirim pesan ke bot, buka
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_PARSE_MODE=HTML
# Random string. Dipakai di URL webhook: https://<APP_URL>/webhooks/telegram/<secret>
TELEGRAM_WEBHOOK_SECRET=

# Discord: paling gampang pakai Incoming Webhook (per channel).
# Multiple webhook boleh, pisah koma.
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URLS=
# Slash-command / interactions (opsional): ambil dari Discord Developer Portal.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Waktu broadcast ulang tahun & kelulusan (Asia/Jakarta).
NOTIFICATIONS_DAILY_TIME=08:00
